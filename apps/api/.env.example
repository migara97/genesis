PORT=8080
HOST=0.0.0.0
# okx | binance | bybit (public MD). LIVE trading remains Binance-signed for now.
EXCHANGE=okx
# OKX symbols look like BTC-USDT-SWAP; Binance/Bybit like BTCUSDT
DEFAULT_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP,XRP-USDT-SWAP,DOGE-USDT-SWAP
EXECUTION_MODE=PAPER
TICK_SIZE_BTC=0.1
TICK_SIZE_ETH=0.01
FOOTPRINT_INTERVAL_MS=60000
# Phase 8 — freeze fingerprint (defaults on in PAPER). Set false to mix configs.
VALIDATION_LOCK_CONFIG=true
# Phase 8 — rotate OF focus across DEFAULT_SYMBOLS (ms). 0 = off.
FOCUS_ROTATION_MS=900000
# Phase 10 — corporate TLS. Prefer a CA file over insecure mode.
# NODE_EXTRA_CA_CERTS=C:\path\to\corp-root.pem
# TLS_CA_FILE=C:\path\to\corp-root.pem
# TLS_INSECURE=1
# LIVE trading — prefer PUT /api/secrets (encrypted). Env is fallback only.
BINANCE_API_KEY=
BINANCE_API_SECRET=
ENCRYPTION_KEY=change-me-to-a-long-random-string
LOG_LEVEL=info
