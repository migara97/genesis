PORT=8080
HOST=0.0.0.0
# okx is default (works in more regions). Use binance where accessible.
EXCHANGE=okx
DEFAULT_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP,XRP-USDT-SWAP,DOGE-USDT-SWAP
EXECUTION_MODE=PAPER
TICK_SIZE_BTC=0.1
TICK_SIZE_ETH=0.01
FOOTPRINT_INTERVAL_MS=60000
# LIVE trading only — never commit real secrets
BINANCE_API_KEY=
BINANCE_API_SECRET=
ENCRYPTION_KEY=change-me-to-a-long-random-string
LOG_LEVEL=info
